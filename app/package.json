{
  "name": "couchdb-mcp-server",
  "version": "1.1.1",
  "description": "CouchDB Control Plane MCP Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev-sse": "tsx src/index.ts --sse",
    "dev-http": "tsx src/index.ts --streamable-http",
    "start": "node dist/index.js",
    "start-http": "node dist/index.js --streamable-http",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "couchdb",
    "server",
    "typescript"
  ],
  "author": "Jack Ni (jackni.jn@gmail.com)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "nano": "^10.1.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
